        { "title": "Medical Biochemistry", "items": ["Biomolecules, enzymes, and metabolism", "Carbohydrate, lipid, and protein metabolism", "Vitamins and minerals", "Clinical chemistry and laboratory interpretation", "Nutrition and energy balance"] },
        { "title": "Microbiology and Parasitology", "items": ["Bacteriology and antimicrobial principles", "Virology and mycology", "Immunology and infection prevention", "Medical parasitology and helminths", "Malaria"] },
        { "title": "Pathology", "items": ["Cell injury, inflammation, and repair", "Neoplasia", "Hematology and transfusion principles", "Systemic pathology", "Specimen handling and diagnostic pathology"] },
